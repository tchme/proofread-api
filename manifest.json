{
  "manifest_version": 3,
  "name": "Proofread API",
  "version": "0.2.2",
  "description": "Исправляет ошибки и запятые, пересказывает другими словами, улучшает стиль и переводит выделенный текст на русский.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Proofread API: настройки", "default_popup": "options.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "options_page": "options.html"
}
